# Server Configuration
PORT=3000

# API Security (Optional - if not set, all requests are allowed)
# Generate a secure random string for production
API_KEY=your-secret-api-key-here

# Session Configuration
# How long sessions should be kept alive (in hours)
SESSION_TTL_HOURS=24

# Instagram Proxy (Optional)
# If you need to use a proxy for Instagram API requests
# Format: http://username:password@proxy-host:port
# IG_PROXY=http://user:pass@proxy.example.com:8080
